# Desk Talk cloud server: secrets and addresses.
# Copy this file to cloud/.env and fill in what you use. Numbers are in cloud/settings.yaml.
# Only SESSION_SECRET is needed to start. Everything else turns one feature on.

# Signs the login cookie. Needed, at least 32 characters, and keep it private.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Where the data lives: a Postgres address, like postgresql+psycopg://user:password@host:5432/desktalk
DATABASE_URL=

# This server's address as a Pi reaches it (shown in the setup command), e.g. http://192.168.1.20:8000
PUBLIC_URL=
# The website's address, where a person lands after logging in. Google sends them back to it, so it must be
# localhost or a real domain (e.g. http://localhost:8000), even when PUBLIC_URL is a home network number.
# Empty = PUBLIC_URL.
LOGIN_URL=

# Log in with Google: make a client ID and secret at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The admin login. With neither set there is no admin login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# The key for whoever writes the weekly report (cloud/settings.yaml: reports.provider)
REPORT_API_KEY=

# The key for the chat a Pi may use through this server (cloud/settings.yaml: chat.url). Empty = chat is off.
CHAT_API_KEY=
