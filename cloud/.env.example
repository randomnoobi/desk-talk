# Desk Talk cloud server: secrets and addresses.
# Copy this file to cloud/.env and fill in what you use. Numbers are in cloud/settings.yaml. README.md explains it all.
# SESSION_SECRET and POSTGRES_PASSWORD are needed to start. Nobody can log in without the two Google values.
# Put a value in single quotes if it has a $ in it.

# Signs the login cookie. Needed, at least 32 characters, and keep it private.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# The database's password. Needed. Letters and digits only, because it goes into an address.
# Make one with:  python3 -c "import secrets; print(secrets.token_hex(24))"
# It's set the first time the database starts: changing it here later does not change it there.
POSTGRES_PASSWORD=

# Where the data lives. Leave it empty with Docker: compose.yaml makes it from POSTGRES_PASSWORD. Only for running the
# server by hand, like postgresql+psycopg://user:password@host:5432/desktalk
DATABASE_URL=

# This server's address as a Pi reaches it (shown in the setup command), e.g. http://192.168.1.20:8080
# Empty = http://localhost:8080, which only works for a Pi on this same computer.
PUBLIC_URL=
# The website's address, where a person lands after logging in. Google sends them back to it, so it must be
# localhost or a real domain (e.g. http://localhost:8080), even when PUBLIC_URL is a home network number.
# Empty = PUBLIC_URL.
LOGIN_URL=

# Log in with Google: make a client ID and secret at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The admin login. Optional: with neither set there is no admin login.
# The first start saves the password. To change it later you need a new username too (README.md).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# The key for whoever writes the weekly report (cloud/settings.yaml: reports.provider). Optional: with none, reports
# are marked failed and say why.
REPORT_API_KEY=

# The key for the chat a Pi may use through this server (cloud/settings.yaml: chat.url). Optional: empty = chat is off.
CHAT_API_KEY=

# Only if you need them. The port the website is on (or address:port, like 127.0.0.1:8080, for this computer only):
# WEB_PORT=8080
# The Docker network, if it clashes with one you use. NETWORK_ADDRESSES is the lower part of NETWORK_SUBNET, and
# WEB_CONTAINER_ADDRESS is one address in the subnet outside that part.
# NETWORK_SUBNET=172.30.87.0/24
# NETWORK_ADDRESSES=172.30.87.0/25
# WEB_CONTAINER_ADDRESS=172.30.87.200
