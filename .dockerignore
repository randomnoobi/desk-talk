# What docker builds never need from the repo's top folder (the cloud server's image builds from it; the detector's has
# its own list, raspberry_pi/detector_service/Dockerfile.dockerignore).
# It keeps the build quick, and your keys and data out of what's sent to Docker.
**/.env
data
models
certs
