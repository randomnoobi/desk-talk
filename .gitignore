# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv
venv
.env
*.egg-info/
.pytest_cache/

# Local HTTPS certificate + pairing key for the camera (made automatically, private key inside)
certs/
.eggs/

# Your own data: event log, habit days, preferences (stays on this computer)
data/
# On a Pi: Desk Talk's own room on the SD card (raspberry_pi/data_room.sh), and the data folder from before it
/data.img*
/data.before-room-*/

# Logs saved by raspberry_pi/get_logs.sh on the Pi, and copied to your Mac by scripts/pi_logs.sh
/pi_logs/

# Personal settings overrides
config/settings.local.yaml
# The same on a Pi: the folder compose.yaml mounts as config/mine (install.sh makes it from settings.mine.example.yaml)
raspberry_pi/mine/

# Large / local-only (GitHub file limit; use Releases or external hosting for video / weights)
*.mp4
*.pt
*.pth
*.onnx

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# App screenshots made by scripts/capture_app_screenshots.py
_screenshots/

# Benchmark models (downloaded and converted by deskbench; ncnn folders hold .param/.bin files)
models/bench/

# Models converted to ncnn (yolo export ... format=ncnn makes a folder next to the .pt)
models/*_ncnn_model/

# coverage data from pytest --cov
.coverage
.coverage.*

# The developer page's packages and build (npm install / npm run build in dev_ui/)
dev_ui/node_modules/
dev_ui/dist/
