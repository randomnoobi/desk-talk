*.mp4
*.pt
*.pth
*.onnx

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# App screenshots made by scripts/capture_app_screenshots.py
_screenshots/

# Benchmark models (downloaded and converted by deskbench; ncnn folders hold .param/.bin files)
models/bench/

# Models converted to ncnn (yolo export ... format=ncnn makes a folder next to the .pt)
models/*_ncnn_model/
