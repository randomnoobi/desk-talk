{
  "include": [
    "desktalk",
    "shared",
    "raspberry_pi",
    "scripts",
    "tests",
    "server.py"
  ],
  "exclude": [
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "benchmarks"
  ],
  // Files that had type errors when pyright was switched on (2026-10-24). Fix a file, then take it off this
  // list, so the count only goes down. Don't add new files here.
  "ignore": [
    "desktalk/core/agents/roster.py",
    "desktalk/core/vision/rules.py",
    "desktalk/domain/events.py",
    "desktalk/web/app.py",
    "desktalk/web/serve.py",
    "raspberry_pi/camera/cameras.py",
    "raspberry_pi/detector_service/desktalk_detector/manager.py",
    "shared/desktalk_shared/detection.py",
    "shared/desktalk_shared/detector_api.py",
    "shared/desktalk_shared/wire.py",
    "tests/integration/test_web_pi_uploads.py",
    "tests/unit/test_camera_program_detector_client.py",
    "tests/unit/test_camera_program_main.py",
    "tests/unit/test_camera_sources_push.py",
    "tests/unit/test_core_agents_profiles.py",
    "tests/unit/test_core_agents_roster.py",
    "tests/unit/test_core_chat_message_generator.py",
    "tests/unit/test_core_chat_together.py",
    "tests/unit/test_core_habits_reminders.py",
    "tests/unit/test_core_habits_tracker.py",
    "tests/unit/test_core_producer.py",
    "tests/unit/test_core_workers_lens.py",
    "tests/unit/test_core_workers_lost_items.py",
    "tests/unit/test_domain.py",
    "tests/unit/test_llm_openai_compatible.py",
    "tests/unit/test_shared_wire.py"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic"
}
