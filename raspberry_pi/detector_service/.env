# Settings for the detector service's Docker container. compose.yaml reads this file.
# After changing a value, run `docker compose up -d` again. No secrets here: API keys never go on the Pi.

# The port the service answers on. Only programs on the Pi itself can reach it (127.0.0.1).
# The camera program must use the same port (the pi.detector settings in config/settings.yaml on your computer).
DETECTOR_PORT=8100

# Most memory the container may use. Over it, Docker restarts the container instead of the Pi freezing.
# 2g suits a Pi with 4 GB or more. On a 2 GB Pi try 1200m, with a small model (yolo11n).
DETECTOR_MEMORY_LIMIT=2g

# Biggest picture /detect accepts, in MB. The Pi's 1280 x 720 pictures are about 0.2 MB.
DETECTOR_MAX_PICTURE_MB=10

# When a model fails to load, wait this many seconds before trying again. The wait doubles after each failure ...
DETECTOR_RETRY_FIRST_SEC=5
# ... up to this many seconds.
DETECTOR_RETRY_MAX_SEC=300

# How often Docker asks /health, and how long one answer may take ...
DETECTOR_HEALTH_INTERVAL=30s
DETECTOR_HEALTH_TIMEOUT=5s
# ... how long after a start it doesn't count failed answers yet (loading PyTorch takes a while on the Pi) ...
DETECTOR_HEALTH_START_PERIOD=60s
# ... and how many failed answers in a row make it "unhealthy".
DETECTOR_HEALTH_RETRIES=3

# The container's log: start a new file at this size (m = MB, 1024 x 1024 bytes) and keep this many files,
# so the logs can't fill the SD card.
DETECTOR_LOG_FILE_SIZE=10m
DETECTOR_LOG_FILES=3
