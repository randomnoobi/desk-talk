# Settings for the Pi's three Docker containers. compose.yaml reads this file.
# After changing a value, run `docker compose up -d` again. No secrets here: API keys never go on the Pi.

# Your time zone, for all three containers. They'd run on UTC without it, and habit days would start at the wrong hour.
TZ=America/Los_Angeles

# ── The app ──
# The port the app answers on inside its container. Must be web.port in config/settings.yaml.
APP_PORT=5000
# The port you open from a phone or computer: http://<the Pi>:5000
APP_HOST_PORT=5000
# The Pi's name on your Wi-Fi, for the links the app shows. install.sh fills this in from the Pi's real name.
PUBLIC_NAME=desktalk.local
# Where the app keeps its data: the event log, habits, to-dos, logs. A plain folder, so you can back it up or scp it.
# It starts from this file's folder, so ../data is the data folder at the top of the repo.
DESKTALK_DATA=../data
# Most memory the container may use. Over it, Docker restarts the container instead of the Pi freezing.
APP_MEMORY_LIMIT=1g
# How often Docker asks the app if it's alive, and how long one answer may take ...
APP_HEALTH_INTERVAL=30s
APP_HEALTH_TIMEOUT=5s
# ... how long after a start it doesn't count failed answers yet, and how often it asks in that time, so the camera
# isn't kept waiting for 30 seconds on every start ...
APP_HEALTH_START_PERIOD=60s
APP_HEALTH_START_INTERVAL=2s
# ... and how many failed answers in a row make it "unhealthy".
APP_HEALTH_RETRIES=3
# Docker does nothing about "unhealthy", so the check itself starts the app again after this many failed answers in a
# row (at one every 30 seconds, that's 2.5 minutes with no answer) ...
APP_HEALTH_FAILS_BEFORE_RESTART=5
# ... not counting failures this many seconds after a start ...
APP_HEALTH_GRACE_SEC=60
# ... and giving one answer this many seconds. Keep it below APP_HEALTH_TIMEOUT.
APP_HEALTH_ANSWER_WAIT_SEC=4

# ── The people who own the files ──
# The Pi's own user and group. The app and the camera run as them, so the files in the data folder are yours.
PI_USER_ID=1000
PI_GROUP_ID=1000
# The number of the Pi's audio group, which may use the sound card. See it **on the Pi** with `getent group audio`.
PI_AUDIO_GROUP=29

# ── The speaker ──
# Sound devices are kind 116 on every Linux. These two let the tests run on a computer with no sound card.
SOUND_DEVICE_MAJOR=116
SOUND_DEVICES=/dev/snd
SOUND_CARDS_FILE=/proc/asound/cards

# ── The clock ──
# The folder where the Pi says its clock has been set from the internet. The tests use their own on a computer.
CLOCK_SYNC_FOLDER=/run/systemd/timesync

# ── The detector ──
# The port it answers on. Only the other two containers can reach it, and only at http://detector:8100.
# pi.detector.url in settings.pi.yaml must use the same port.
DETECTOR_PORT=8100
# 2g suits a Pi with 4 GB or more. On a 2 GB Pi try 1200m, with a small model (yolo11n).
DETECTOR_MEMORY_LIMIT=2g
# Biggest picture /detect accepts, in MB. The Pi's 1280 x 720 pictures are about 0.2 MB.
DETECTOR_MAX_PICTURE_MB=10
# When a model fails to load, wait this many seconds before trying again. The wait doubles after each failure ...
DETECTOR_RETRY_FIRST_SEC=5
# ... up to this many seconds.
DETECTOR_RETRY_MAX_SEC=300
# Docker's health check, as for the app. Loading PyTorch takes a while on the Pi.
DETECTOR_HEALTH_INTERVAL=30s
DETECTOR_HEALTH_TIMEOUT=5s
DETECTOR_HEALTH_START_PERIOD=60s
DETECTOR_HEALTH_RETRIES=3
# As for the app, with more room: a model being converted can keep it too busy to answer. 10 failures at one every 30
# seconds is 5 minutes with no answer, and it has 5 minutes after a start.
DETECTOR_HEALTH_FAILS_BEFORE_RESTART=10
DETECTOR_HEALTH_GRACE_SEC=300
DETECTOR_HEALTH_ANSWER_WAIT_SEC=4

# ── The camera ──
# Most memory the container may use, counting the pictures it keeps in memory (the next one).
CAMERA_MEMORY_LIMIT=512m
# Room for the pictures, kept in memory and not on the SD card. Ten minutes of pictures of a full desk (pi.delete_every_min)
# at 3 a second are about 180 MB; the camera program itself takes up to about 125 MB more.
CAMERA_PHOTOS_SIZE=300m
# The number of the Pi's video group, which may use the camera's devices.
CAMERA_VIDEO_GROUP=44
# The kinds of device the camera may open. Each kind has a number; see them **on the Pi** with `cat /proc/devices`.
# video4linux is always 81, but the kernel hands out the other two, so they can change with a new kernel:
# media and dma_heap. If the camera says it can't be found after an update, check these first.
CAMERA_VIDEO_MAJOR=81
CAMERA_MEDIA_MAJOR=510
CAMERA_DMA_HEAP_MAJOR=252
# It counts as healthy if it saved a picture in the last this many minutes.
CAMERA_HEALTH_RECENT_MIN=2
# Docker's health check, as for the app.
CAMERA_HEALTH_INTERVAL=30s
CAMERA_HEALTH_TIMEOUT=5s
CAMERA_HEALTH_START_PERIOD=60s
CAMERA_HEALTH_START_INTERVAL=2s
CAMERA_HEALTH_RETRIES=3

# ── Log files, for all three ──
# Start a new file at this size (m = MB, 1024 x 1024 bytes) and keep this many files, so logs can't fill the SD card.
LOG_FILE_SIZE=10m
LOG_FILES=3

# ── The install script ──
# raspberry_pi/install.sh and update.sh read these. The containers don't use them.
# A Pi still called the first of these gets the second, so it's easy to find: http://desktalk.local:5000. A Pi someone
# has named keeps its name. `install.sh --keep-hostname` writes the present name in the second, so later runs leave it.
INSTALL_STOCK_HOSTNAME=raspberrypi
INSTALL_HOSTNAME=desktalk
# Free disk needed for the first build, in MB. Measured on a Pi: the images and Docker's saved build steps take about
# 12.6 GB on the card, with a little more for the model and its ncnn version. So use a 32 GB card: a 16 GB one is too small.
INSTALL_MIN_DISK_MB=14000
# With the images already built, free disk needed to run this again or rebuild what changed, in MB.
INSTALL_MIN_DISK_BUILT_MB=2000
# After a build, with less free disk than this, in MB, Docker's saved build steps are cleared. Until then they stay, so
# an update with little new code takes a minute or two, not the 12 to 21 minutes of a whole new build.
INSTALL_CLEAR_BUILDS_BELOW_MB=3000
# It won't install on a Pi with less memory than this, in MB (a 2 GB Pi shows about 1900) ...
INSTALL_MIN_MEMORY_MB=1800
# ... and below this it says to lower DETECTOR_MEMORY_LIMIT: the three limits above add up to about this much.
INSTALL_GOOD_MEMORY_MB=3500
# The Pi's boot settings. The memory limits above need a word in the first, and the camera a line in the second.
INSTALL_BOOT_CMDLINE=/boot/firmware/cmdline.txt
INSTALL_BOOT_CONFIG=/boot/firmware/config.txt
# Docker's own install script, used only if Docker is missing.
INSTALL_DOCKER_SCRIPT=https://get.docker.com
# Where models come from, the same place Ultralytics fetches them. The file name is pi.detector.model in the settings.
INSTALL_MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.4.0
# A download gets this many tries. It gives up on a try if it can't connect within this many seconds ...
INSTALL_DOWNLOAD_TRIES=3
INSTALL_DOWNLOAD_CONNECT_SEC=30
# ... or hasn't finished within this many ...
INSTALL_DOWNLOAD_MAX_SEC=1800
# ... or has gone slower than this many bytes a second for this many seconds, so a stalled download gives up soon.
INSTALL_DOWNLOAD_SLOWEST_BYTES_SEC=1024
INSTALL_DOWNLOAD_STALL_SEC=60
