# Desk Talk — secrets, AI connection and your phone's notifications
# Copy this file to .env and fill in what you use. Everything else (camera,
# timings, habit rules) lives in config/settings.yaml.

# ── AI: optional. settings → llm.ai_url wins when it's set; otherwise the first one with a value here:
# Gemini → OpenAI → Groq → Ollama ──

# Google Gemini (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Ollama (fully local, no key): install from https://ollama.com, then e.g.
#   ollama pull llama3.2      (chat)
#   ollama pull llava         (vision: lost items)
OLLAMA_URL=
# Model names can be set here too (they override config/settings.yaml → llm):
# OLLAMA_MODEL=llama3.2
# LOST_VISION_MODEL=llava

# ── Your phone: optional. Warnings, reminders and sips also go to your phone through ntfy (https://ntfy.sh), but
# never a to-do's words. Empty = off. The topic is a secret: anyone who knows it can read and send these, so make
# it long and random, never a word like "desktalk". Make one with
#   python3 -c "import secrets; print('desktalk-' + secrets.token_urlsafe(18))"
# then subscribe to it in the ntfy app on your phone. (On the Pi it goes in raspberry_pi/.env instead.)
# settings → notifications.phone_server says which ntfy server. ──
NTFY_TOPIC=
