# Desk Talk — secrets and AI connection
# Copy this file to .env and fill in what you use. Everything else (camera,
# timings, habit rules) lives in config/settings.yaml.

# ── AI: the first one with a value wins: Gemini → OpenAI → Groq → Ollama ──

# Google Gemini (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Ollama (fully local, no key): install from https://ollama.com, then e.g.
#   ollama pull llama3.2      (chat)
#   ollama pull llava         (vision: posture, lost items)
OLLAMA_URL=
# Model names can be set here too (they override config/settings.yaml → llm):
# OLLAMA_MODEL=llama3.2
# LOST_VISION_MODEL=llava
