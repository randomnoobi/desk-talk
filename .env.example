# Desk Talk — Configuration
# Copy this file to .env and fill in your values.

# ── LLM (pick ONE — first match wins: Gemini → OpenAI → Groq → Ollama) ──

# Option 1: Google Gemini (default — free tier available)
#   Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenAI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Option 3: Groq (free tier — generous limits, fast!)
#   Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 4: Ollama (fully local, no API key needed)
#   Install from https://ollama.com e.g. ollama pull gpt-oss:20b
#   - Text chat + JSON-style LLM tasks use OLLAMA_MODEL.
#   - Object *boxes* on camera are YOLO (YOLO_MODEL below), not the LLM.
#   - Image / lost-item vision (VLM) needs a *vision* model. gpt-oss:20b is text-only in Ollama;
#     set LOST_VISION_MODEL to e.g. llava or llama3.2-vision (ollama pull those separately).
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
# LOST_VISION_MODEL=llava

# Periodic Ollama VLM scene pass (posture, screen distance, phone in hand) — seconds between runs
# HABIT_VLM_INTERVAL_SEC=42

# Auto-save a full-frame “Desk scan” snapshot after each lost-item VLM pass (min seconds apart)
# DESK_SCAN_SNAPSHOT_MIN_SEC=120

# When these YOLO classes newly appear in frame, save one snapshot (comma-separated, default = phone/keys-wallet-proxy/scissors/bag)
# LOSEABLE_SNAPSHOT_CLASSES=cell phone,remote,handbag,scissors

# Min seconds between duplicate “spotted” snapshots for the same class / VLM channel
# LOSEABLE_SNAPSHOT_COOLDOWN_SEC=75

# Monty habit log (vision): min slouch duration before logging when posture reads "good" again
# HABIT_POSTURE_SEGMENT_MIN_SEC=90
# HABIT_NAIL_EVENT_COOLDOWN_SEC=50
# HABIT_LOG_MAX_EVENTS=120

# Rate limiting — min seconds between LLM calls (prevent quota burn)
MIN_LLM_INTERVAL=6

# ── Camera ──

# phone (default) = your phone streams the desk over Wi-Fi; scan the QR code shown at
#                   http://localhost:5000 or in the terminal.
# webcam          = old behavior: a USB / built-in webcam on this computer (uses the settings below).
CAMERA_SOURCE=phone
# HTTPS port the phone connects to (phones only allow the camera on https:// pages)
# PHONE_PORT=5443

# External USB webcams are often OpenCV index 1 on Mac (0 = built-in FaceTime). Example: PIPELINE_CAMERA=1
# PIPELINE_CAMERA=0

# Or comma-separated indices for the web server only (overrides PIPELINE_CAMERA when set):
# CAMERA_INDICES=0,1
CAMERA_INDICES=0

# YOLO / Ultralytics — default weights/yolo26n.pt (downloaded if missing; override with full path)
# YOLO_MODEL=weights/yolo26n.pt
# YOLO confidence threshold (default: 0.45)
CONFIDENCE=0.45

# ── Events ──

# Minimum seconds between messages for the same event type (default: 25)
EVENT_COOLDOWN=25

# Proximity ratio — fraction of frame width that counts as "close" (default: 0.22)
PROXIMITY_RATIO=0.22

# Temporal smoothing — consecutive frames needed to confirm appear/disappear
APPEAR_FRAMES=10
DISAPPEAR_FRAMES=40
